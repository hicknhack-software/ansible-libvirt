#cloud-config
# {{ ansible_managed }}
hostname: {{ libvirt_result_domain_name }}
{# sudo would fail if hosts are unmanaged #}
manage_etc_hosts: localhost
groups:
{% for user in libvirt_cloud_config_users if user.groups is defined %}
{%   for group in user.groups.split(',') %}
- {{ group }}
{%   endfor %}
{% endfor %}
users:
{{ libvirt_cloud_config_users | to_nice_yaml(indent=2) }}
{% if libvirt_apt_mirror | default(false) is truthy %}
apt:
  primary:
  - arches: [default]
    search:
{%   for mirror in libvirt_apt_mirror.split(',') %}
    - {{ mirror }}
{%   endfor %}
{% endif %}
{% if libvirt_cloud_config_packages | default(false) is truthy %}
packages:
{%   for package in libvirt_cloud_config_packages %}
- {{ package }}
{%   endfor %}
{% endif %}
{# python ensures ansible can manage this host #}
{% if libvirt_cloud_config_bootcmd | default(false) is truthy %}
bootcmd:
{{ libvirt_cloud_config_bootcmd | to_nice_yaml(indent=2) }}
{% endif %}
{# alternative to manage_etc_hosts that allows to specify the full hostname
bootcmd:
- [ cloud-init-per, once, configure-hostname, "/bin/sh", "-c", "echo 127.0.1.1 {{ libvirt_result_domain_name }} >> /etc/hosts" ]
#}
{% if libvirt_cloud_config_timezone | default(false) is truthy %}
timezone: {{ libvirt_cloud_config_timezone }}
{% endif %}
{% if libvirt_extra_disks | default(false) is truthy %}
{%   set alpha = 'abcdefghijklmnopqrstuvwxyz' %}
{%   set vd_index = 2 %}{# 0 - boot disk, 1 - cloud-config #}
{#
disk_setup:
{%   for disk in libvirt_extra_disks %}
  /dev/vd{{ alpha[vd_index] }}:
    table_type: mbr
    layout: true
    overwrite: false
{%     set vd_index = vd_index + 1 %}
{%   endfor %}
#}
{%   set vd_index = 2 %}{# 0 - boot disk, 1 - cloud-config #}
fs_setup:
{%   for disk in libvirt_extra_disks %}
- label: '{{ disk.label | default(disk.id | default('data', true), true) }}'
  filesystem: '{{ disk.fs | default('ext4', true) }}'
  device: '/dev/vd{{ alpha[vd_index] }}'
  partition: none
  overwrite: false
{%     set vd_index = vd_index + 1 %}
{%   endfor %}
{%   set vd_index = 2 %}{# 0 - boot disk, 1 - cloud-config #}
mounts:
{%   for disk in libvirt_extra_disks %}
- [ 'vd{{ alpha[vd_index] }}', '{{ disk.mount_path | default('/data', true) }}', 'auto', '{{ disk.mount_opts | default('defaults,noatime,nodev') }}' ]
{%     set vd_index = vd_index + 1 %}
{%   endfor %}
{% endif %}
